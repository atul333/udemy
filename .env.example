# ================================================
# Udemy Course Coupons Bot - Environment Template
# ================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

# Telegram Bot Token (get from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel IDs to post courses to (comma-separated)
CHANNEL_IDS=@your_channel_1,@your_channel_2,@your_channel_3

# How often to check for new courses (in seconds, default: 300 = 5 min)
CHECK_INTERVAL=300

# How often to send the advertisement (in seconds, default: 3600 = 1 hour)
AD_INTERVAL=3600

# Enable/disable advertisement posting (true/false, default: false)
ENABLE_ADS=false
